#ifndef SECRETS_H
#define SECRETS_H

// ------------------------------------------------------------------
// Secret material for the Doctordrobe firmware.
// Copy this file to `secrets.h` and fill in real values. `secrets.h`
// is git-ignored and must never be committed.
//
// Device API key — uncomment and set when the backend sets
// DEVICE_API_KEY. The sketch then sends it as the X-API-Key header.
// Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
// #define DEVICE_API_KEY "replace-me-with-a-real-api-key"
//
// TLS root CA (PEM) — required only when USE_HTTPS is true:
//   - Public TLS: the ESP32 trust bundle covers most public CAs; no
//     action needed.
//   - Private/self-signed CA: paste the full PEM chain into
//     ROOT_CA_PEM below and uncomment the setCACert line in the sketch.
// const char* ROOT_CA_PEM =
//     "-----BEGIN CERTIFICATE-----\n"
//     "...\n"
//     "-----END CERTIFICATE-----\n";
// ------------------------------------------------------------------

#endif // SECRETS_H
