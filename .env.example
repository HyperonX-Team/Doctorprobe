# ------------------------------------------------------------------
# Doctordrobe deployment secrets (docker-compose).
# Copy to .env and fill in real values. NEVER commit the .env file.
# ------------------------------------------------------------------

# Secret used to derive the Fernet key that encrypts reports at rest.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FERNET_KEY=dev-key-change-me-please-replace

# Device API key — set to require X-API-Key on /api/devices/reading.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=

# Comma-separated JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:80","http://localhost:5173"]
