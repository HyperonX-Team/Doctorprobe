# ------------------------------------------------------------------
# Doctordrobe backend environment (development defaults).
# Copy to .env and adjust. Never commit real secrets.
# ------------------------------------------------------------------

# SQLite for local development; Postgres via docker-compose.
DATABASE_URL=sqlite:///./doctordrobe.db

ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Secret used to derive the Fernet encryption key for reports at rest.
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FERNET_KEY=dev-key-change-me

# Optional device API key. When set, POST /api/devices/reading requires
# the X-API-Key header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# DEVICE_API_KEY=

# Tokens awarded per shared checkup.
TOKEN_REWARD=5

# A device is "connected" if last seen within this many seconds.
DEVICE_STALE_SECONDS=300
