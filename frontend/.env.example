# ------------------------------------------------------------------
# Doctordrobe frontend environment template.
# Copy to .env.development / .env.production as needed.
# ------------------------------------------------------------------

# Base URL for the backend REST API.
# Development: point directly at the local FastAPI server.
VITE_API_BASE_URL=http://localhost:8000

# Production: served same-origin, Nginx proxies /api to the backend.
# VITE_API_BASE_URL=/api
